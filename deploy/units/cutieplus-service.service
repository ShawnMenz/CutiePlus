# The CutiePlus cooperation service (deploy/install.sh): sign-in, roles, the database, the GPU
# queue. It runs as the protected cutieplus account from the root-owned release in /opt/cutieplus,
# and cannot read the desktop account's home.
[Unit]
Description=CutiePlus cooperation service
After=network.target cutieplus-helper.service
Wants=cutieplus-helper.service

[Service]
User=cutieplus
Group=cutieplus
ExecStart=/opt/cutieplus/venv/bin/python -I -m cutieplus.cooperation serve --config /etc/cutieplus/service.toml
RuntimeDirectory=cutieplus
RuntimeDirectoryMode=0755
StateDirectory=cutieplus
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cutieplus
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
