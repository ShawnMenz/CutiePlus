# The annotation SSH entrypoint (deploy/install.sh): its own sshd and configuration, on its own
# port. Collaborators' keys only, each forwarding to its own remote desktop; no shell, no SFTP.
# The account's usual sshd (port 22) is left as it is.
[Unit]
Description=CutiePlus annotation SSH entrypoint
After=network.target

[Service]
ExecStartPre=/usr/bin/mkdir -p -m 0755 /run/sshd
ExecStartPre=/usr/sbin/sshd -t -f /etc/cutieplus/sshd_config
ExecStart=/usr/sbin/sshd -D -f /etc/cutieplus/sshd_config
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
